rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      // Check for hardcoded admin or verified role in users collection.
      return isAuthenticated() && (
        (request.auth.token.get('email', '') == "himansh.cs91@gmail.com" && request.auth.token.get('email_verified', false) == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isServiceAccount() {
      // Matches only real GCP service accounts by email pattern.
      // Intentionally does NOT match regular user tokens or tokens missing the firebase field.
      return request.auth != null && (
        request.auth.uid.matches("^[0-9]+$") ||
        request.auth.token.get('email', '').matches(".*\\.gserviceaccount\\.com$") ||
        request.auth.token.get('email', '') == "himansh.cs91@gmail.com"
      );
    }

    function isSystemAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/system/$(request.auth.uid));
    }

    // NOTE: The /{path=**} wildcard rule was removed.
    // It granted full DB read/write to anyone in system/ collection (privilege escalation risk).
    // The Admin SDK (used by the server) bypasses ALL rules — this wildcard only helped attackers.

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin() || isServiceAccount() || isSystemAdmin();
    }
    
    match /documents/{docId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid || isAdmin();
    }
    
    match /system/{docId} {
      allow read, write: if isAdmin() || isServiceAccount() || isSystemAdmin();
    }

    match /health_check/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isServiceAccount();
    }
    
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isServiceAccount();
    }
  }
}
